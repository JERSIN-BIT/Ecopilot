<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9F6">

    <!-- CONTENIDO PRINCIPAL CON SCROLL (Arriba de la barra) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:padding="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- LOGO CIRCULAR -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                android:elevation="4dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="#FFFFFF">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/logo_ecopilot"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <!-- Saludo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Hola, Reciclador!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center"
                android:layout_marginBottom="2dp"/>

            <!-- INSIGNIA DE RANGO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ Rango: Piloto Ambiental"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#388E3C"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen de tu impacto ambiental"
                android:textSize="13sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Tarjeta de Eco-Puntos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2E7D32"
                android:padding="18dp"
                android:layout_marginBottom="20dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tus Eco-Puntos"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="450 pts"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#A5D6A7"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♻ Total Reciclado: 18.5 kg"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Botón Principal de Acción -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewRecycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Registrar Entrega de Reciclaje"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="#FFFFFF"
                app:iconGravity="start" />

            <!-- Botón Cerrar Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar Sesión"
                style="?attr/materialButtonOutlinedStyle"
                android:textColor="#D32F2F"
                android:padding="12dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="#D32F2F"
                app:iconGravity="start" />

        </LinearLayout>
    </ScrollView>

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:menu="@menu/bottom_menu" />

</RelativeLayout>