<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#F5F9F6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mi Perfil"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="24dp"/>

    <!-- Imagen de perfil simulada -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:background="#C8E6C9"
        android:padding="20dp"
        android:layout_marginBottom="24dp"/>

    <!-- Datos del Usuario -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre completo:"
        android:textColor="#666666"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Juan David Hernández"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Correo electrónico:"
        android:textColor="#666666"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tvProfileEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="juandavid@gmail.com"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rol en EcoPilot:"
        android:textColor="#666666"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tvProfileRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ciudadano / Reciclador"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="32dp"/>

    <!-- Botón Volver -->
    <Button
        android:id="@+id/btnBackProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver al Dashboard"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:padding="12dp"/>

</LinearLayout>